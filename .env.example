# Velvet Octopus Films — Cloudflare Worker environment variables
# Copy this to .env and fill in the values before deploying.
# NEVER commit .env to the repository.

# ── Licensing inquiry Worker (functions/inquiry.js) ─────────────────────────

# Resend API key — get from https://resend.com/api-keys
# This is the ONLY place the key lives. Never put it in config.js or any
# browser-side file.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# Verified sender address. Must be verified in your Resend account.
# Add the domain at https://resend.com/domains before sending.
FROM_EMAIL=licensing@velvetoctopusfilms.com

# Inbox that receives licensing inquiry notifications.
NOTIFY_TO=licensing@velvetoctopusfilms.com

# Exact origin of the deployed site (no trailing slash).
# Set to "*" while developing; tighten to the real domain before launch.
ALLOW_ORIGIN=https://velvetoctopusfilms.com


# ── Film submission Worker (functions/submission.js) ─────────────────────────

# Same Resend key works for both Workers if deployed to the same project.
# RESEND_API_KEY= (same as above)

# Verified sender for submission emails.
# FROM_EMAIL= (can be the same as above, or a different verified address)

# Inbox for film submission notifications.
SUBMISSION_NOTIFY_TO=submit@velvetoctopusfilms.com

# ALLOW_ORIGIN= (same value as above)
